#!/bin/sh
# Run the test suite on the runtime target (/usr/bin/python3, 3.9) with pytest provided by uv, in parallel.
# Usage: scripts/test [--all] [pytest args]
#   default: the fast tests only (no processes started; a few seconds)
#   --all:   also the tests marked slow (real git, gitleaks, install.sh; about a minute)
cd "$(dirname "$0")/.." || exit 1
exec uv run --no-project --python /usr/bin/python3 --with pytest --with pytest-xdist -- \
    python -m pytest -q -n auto --maxprocesses=8 "$@"
