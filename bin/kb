#!/bin/sh
# kb — search and analyze your Claude Code and Codex sessions. Run `kb --help`.
# The code is the retroagent folder this script lives in (symlinks are followed). A plugin's cached copy (Claude Code,
# Codex) runs the code clone that install.sh recorded as "code" in the config instead, so the hook, the plugin's PATH
# and the shell all run one version. The data repo is $KB_ROOT, else "root" in the config, else ~/.retroagent-data.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
CODE=$(cd "$(dirname "$self")/.." && pwd)
case "$CODE" in
  */plugins/cache/*)
    CFG="${KB_CONFIG:-$HOME/.config/retroagent/config.json}"
    CLONE=""
    [ -f "$CFG" ] && CLONE=$(sed -n 's/.*"code"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG" | head -n 1)
    if [ -n "$CLONE" ] && [ -f "$CLONE/src/kb/cli.py" ]; then CODE=$CLONE; fi ;;
esac
PYTHONPATH="$CODE/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m kb "$@"
