#!/bin/sh
# PreToolUse hook (Bash): refuse an agent's call to `kb decide accept|reject`. Only the owner answers the questions of
# `kb decide` (src/kb/decide.py): in their own terminal, or with the buttons of the decide mod (hooks/decide.tsx), which run kb
# directly and are no tool call. Session text can hold instructions from other people, and an accepted suggestion or
# memory fix reaches every later session. Matches only a call (kb after a separator or a space, or a path that ends in
# /kb, also quoted like "kb", with options such as --yes before the answer, and inside `sh -c "..."` or eval), so a search
# for the words in a file goes through. Prints nothing and exits 0 for every other command.
# Defense in depth, not a sandbox: `kb decide` itself also refuses accept|reject without a terminal or --yes.
INPUT=$(cat)
DENY='{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "retroagent: only the user answers `kb decide` questions, in their own terminal. Tell the user which answer you suggest and why; do not run it."}}'
if command -v python3 >/dev/null 2>&1; then
  if printf '%s' "$INPUT" | python3 -c '
import json, re, sys
try:
    cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
except Exception:
    sys.exit(1)
if not isinstance(cmd, str):
    sys.exit(1)
cmd = re.sub(r"""(["\x27])((?:[^\s"\x27;&|]*/)?kb)\1""", r"\2", cmd)   # "kb" and "/x/kb" run kb
start = r"(?:^|[;&|(`\s])"
if re.search(r"(?:\b(?:ba|z|da|k)?sh\s+(?:-\w+\s+)*-\w*c\b|\beval\b)", cmd):
    start = r"(?:^|[;&|(`\s\"\x27])"                                  # the call can sit inside a quoted script
call = start + r"(?:[^\s\"\x27;&|`]*/)?kb\s+decide\b[^;&|\n`)]*?(?<![\w=-])(?:accept|reject)(?![\w=-])"
sys.exit(0 if re.search(call, cmd) else 1)
'; then
    printf '%s\n' "$DENY"
  fi
elif printf '%s' "$INPUT" | grep -Eq '(^|[;&|(`]|\\n|\\t|[[:space:]]|:[[:space:]]*")([^[:space:]";&|]*/)?kb([[:space:]]|\\t)+decide([[:space:]]|\\t)+([^;&|]*[[:space:]])?(accept|reject)([[:space:]]|\\|"|$)'; then
  printf '%s\n' "$DENY"
fi
exit 0
