#!/bin/sh
# kb — search and analyze your Claude Code and Codex sessions. Run `kb --help`.
# Finds the KB repo from $KB_ROOT, else "root" in ~/.config/sessions-kb/config.json, else ~/Repositories/sessions-kb.
CFG="${KB_CONFIG:-$HOME/.config/sessions-kb/config.json}"
ROOT="${KB_ROOT:-}"
if [ -z "$ROOT" ] && [ -f "$CFG" ]; then
  ROOT=$(sed -n 's/.*"root"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG" | head -n 1)
fi
[ -n "$ROOT" ] || ROOT="$HOME/Repositories/sessions-kb"
case "$ROOT" in "~"*) ROOT="$HOME${ROOT#\~}" ;; esac
export KB_ROOT="$ROOT"
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m kb "$@"
